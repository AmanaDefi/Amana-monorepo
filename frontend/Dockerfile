FROM node:22.16.0 AS builder
RUN apt update \
    && apt install -y python3 make g++ libusb-1.0-0-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ARG NEXT_PUBLIC_DEPLOY_ENV
ARG NEXT_PUBLIC_TEMPLATE_CLIENT_ID
ARG NEXT_PUBLIC_ALCHEMY_RPC_URL_BASE
ARG NEXT_PUBLIC_ALCHEMY_RPC_URL_BASE_SEPOLIA
ARG NEXT_PUBLIC_ALCHEMY_RPC_URL_ZETA
ARG NEXT_PUBLIC_ALCHEMY_RPC_URL_ZETA_TESTNET
ARG NEXT_PUBLIC_ALCHEMY_RPC_URL_ETH
ARG NEXT_PUBLIC_ALCHEMY_RPC_URL_SEPOLIA
ARG NEXT_PUBLIC_ALCHEMY_RPC_URL_POLYGON
ARG NEXT_PUBLIC_ALCHEMY_RPC_URL_POLYGON_AMOY
ARG NEXT_PUBLIC_ALCHEMY_RPC_URL_BSC
ARG NEXT_PUBLIC_ALCHEMY_RPC_URL_BSC_TESTNET
ARG NEXT_PUBLIC_ALCHEMY_RPC_URL_AVALANCHE
ARG NEXT_PUBLIC_ALCHEMY_RPC_URL_AVALANCHE_FUJI
ARG NEXT_PUBLIC_ALCHEMY_RPC_URL_ARBITRUM_ONE
ARG NEXT_PUBLIC_ALCHEMY_RPC_URL_ARBITRUM_GOERLI
ARG NEXT_PUBLIC_EVM_GATEWAY_ADDRESS
ARG NEXT_PUBLIC_EVM_GATEWAY_ADDRESS_TESTNET
ARG NEXT_PUBLIC_WITHDRAWAL_RECEIVER_ADDRESS_TESTNET
ARG NEXT_PUBLIC_WITHDRAWAL_RECEIVER_ADDRESS
ARG NEXT_PUBLIC_SOLANA_RPC_ENDPOINT
ARG NEXT_PUBLIC_SOLANA_RPC_ENDPOINT_DEVNET
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_AMANA_BACKEND_API_KEY
ARG NEXT_PUBLIC_BEAM_API_KEY
ARG NEXT_PUBLIC_ALCHEMY_API_KEY
ARG NEXT_PUBLIC_BLOCKPI_URL
ARG NEXT_PUBLIC_GRAPH_API_KEY
ARG NEXT_PUBLIC_GRAPH_URL
ARG NEXT_PUBLIC_PRIVY_APP_ID
ARG NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID

ENV NEXT_PUBLIC_DEPLOY_ENV=$NEXT_PUBLIC_DEPLOY_ENV \
    NEXT_PUBLIC_ALCHEMY_RPC_URL_BASE=$NEXT_PUBLIC_ALCHEMY_RPC_URL_BASE \
    NEXT_PUBLIC_ALCHEMY_RPC_URL_BASE_SEPOLIA=$NEXT_PUBLIC_ALCHEMY_RPC_URL_BASE_SEPOLIA \
    NEXT_PUBLIC_ALCHEMY_RPC_URL_ZETA=$NEXT_PUBLIC_ALCHEMY_RPC_URL_ZETA \
    NEXT_PUBLIC_ALCHEMY_RPC_URL_ZETA_TESTNET=$NEXT_PUBLIC_ALCHEMY_RPC_URL_ZETA_TESTNET \
    NEXT_PUBLIC_ALCHEMY_RPC_URL_ETH=$NEXT_PUBLIC_ALCHEMY_RPC_URL_ETH \
    NEXT_PUBLIC_TEMPLATE_CLIENT_ID=$NEXT_PUBLIC_TEMPLATE_CLIENT_ID \
    NEXT_PUBLIC_ALCHEMY_RPC_URL_SEPOLIA=$NEXT_PUBLIC_ALCHEMY_RPC_URL_SEPOLIA \
    NEXT_PUBLIC_ALCHEMY_RPC_URL_POLYGON=$NEXT_PUBLIC_ALCHEMY_RPC_URL_POLYGON \
    NEXT_PUBLIC_ALCHEMY_RPC_URL_POLYGON_AMOY=$NEXT_PUBLIC_ALCHEMY_RPC_URL_POLYGON_AMOY \
    NEXT_PUBLIC_ALCHEMY_RPC_URL_BSC=$NEXT_PUBLIC_ALCHEMY_RPC_URL_BSC \
    NEXT_PUBLIC_ALCHEMY_RPC_URL_BSC_TESTNET=$NEXT_PUBLIC_ALCHEMY_RPC_URL_BSC_TESTNET \
    NEXT_PUBLIC_ALCHEMY_RPC_URL_AVALANCHE=$NEXT_PUBLIC_ALCHEMY_RPC_URL_AVALANCHE \
    NEXT_PUBLIC_ALCHEMY_RPC_URL_AVALANCHE_FUJI=$NEXT_PUBLIC_ALCHEMY_RPC_URL_AVALANCHE_FUJI \
    NEXT_PUBLIC_ALCHEMY_RPC_URL_ARBITRUM_ONE=$NEXT_PUBLIC_ALCHEMY_RPC_URL_ARBITRUM_ONE \
    NEXT_PUBLIC_ALCHEMY_RPC_URL_ARBITRUM_GOERLI=$NEXT_PUBLIC_ALCHEMY_RPC_URL_ARBITRUM_GOERLI \
    NEXT_PUBLIC_EVM_GATEWAY_ADDRESS=$NEXT_PUBLIC_EVM_GATEWAY_ADDRESS \
    NEXT_PUBLIC_EVM_GATEWAY_ADDRESS_TESTNET=$NEXT_PUBLIC_EVM_GATEWAY_ADDRESS_TESTNET \
    NEXT_PUBLIC_WITHDRAWAL_RECEIVER_ADDRESS_TESTNET=$NEXT_PUBLIC_WITHDRAWAL_RECEIVER_ADDRESS_TESTNET \
    NEXT_PUBLIC_WITHDRAWAL_RECEIVER_ADDRESS=$NEXT_PUBLIC_WITHDRAWAL_RECEIVER_ADDRESS \
    NEXT_PUBLIC_SOLANA_RPC_ENDPOINT=$NEXT_PUBLIC_SOLANA_RPC_ENDPOINT \
    NEXT_PUBLIC_SOLANA_RPC_ENDPOINT_DEVNET=$NEXT_PUBLIC_SOLANA_RPC_ENDPOINT_DEVNET \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_AMANA_BACKEND_API_KEY=$NEXT_PUBLIC_AMANA_BACKEND_API_KEY \
    NEXT_PUBLIC_BEAM_API_KEY=$NEXT_PUBLIC_BEAM_API_KEY
    NEXT_PUBLIC_ALCHEMY_API_KEY=$NEXT_PUBLIC_ALCHEMY_API_KEY
    NEXT_PUBLIC_BLOCKPI_URL=$NEXT_PUBLIC_BLOCKPI_URL
    NEXT_PUBLIC_GRAPH_API_KEY=$NEXT_PUBLIC_GRAPH_API_KEY
    NEXT_PUBLIC_GRAPH_URL=$NEXT_PUBLIC_GRAPH_URL
    NEXT_PUBLIC_PRIVY_APP_ID=$NEXT_PUBLIC_PRIVY_APP_ID
    NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=$NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID

COPY package*.json next.config.mjs yarn.lock ./
RUN yarn install --immutable
COPY ./ ./
RUN yarn run build
RUN yarn install --immutable --prod

FROM node:22-slim AS runner
WORKDIR /app

COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/package.json ./package.json

EXPOSE 3000
CMD ["yarn", "run", "start"]