{
    "name": "@amana/subgraph",
    "version": "1.0.0",
    "license": "MIT",
    "scripts": {
        "codegen": "graph codegen subgraph.yaml",
        "build": "graph build subgraph.yaml",
        "auth": "graph auth $GRAPH_API_KEY",
        "deploy": "powershell -ExecutionPolicy Bypass -File deploy.ps1",
        "deploy:unix": "yarn auth && yarn build && graph deploy amana/amana-zetachain --access-token $GRAPH_API_KEY",
        "deploy:hosted": "yarn build && graph deploy amana/amana-zetachain --access-token $GRAPH_API_KEY",
        "test": "graph test"
    },
    "dependencies": {
        "@graphprotocol/graph-cli": "^0.97.1",
        "@graphprotocol/graph-ts": "^0.38.1",
        "ethers": "^6.14.4"
    }
}
